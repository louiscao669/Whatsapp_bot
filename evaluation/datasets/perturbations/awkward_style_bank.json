{
  "schema_version": 1,
  "description": "Rule-based literalization replacements for simulating MQM Style/Awkward translationese while preserving core meaning.",
  "categories": {
    "light_verb_inflation": {
      "description": "Replace concise verbs with clunky light-verb constructions.",
      "replacements": [
        { "source": "说", "target": "进行说话" },
        { "source": "问", "target": "进行询问" },
        { "source": "回答", "target": "进行回答" },
        { "source": "赞美", "target": "进行赞美" },
        { "source": "称赞", "target": "进行称赞" },
        { "source": "拯救", "target": "进行拯救" },
        { "source": "救", "target": "进行拯救" },
        { "source": "看见", "target": "进行看见" },
        { "source": "听见", "target": "进行听见" },
        { "source": "问安", "target": "进行问候的行为" },
        { "source": "预言", "target": "进行预言的说话" },
        { "source": "等候", "target": "进行等候" },
        { "source": "服侍", "target": "进行服侍" },
        { "source": "赦免", "target": "进行赦免" },
        { "source": "相信", "target": "进行相信" },
        { "source": "拒绝", "target": "进行拒绝" }
      ]
    },
    "nominalization": {
      "description": "Turn natural events/states into noun-heavy expressions.",
      "replacements": [
        { "source": "怀孕", "target": "对怀孕这件事进行经历" },
        { "source": "生了一个儿子", "target": "进行了一个儿子的生产" },
        { "source": "生一个儿子", "target": "进行一个儿子的生产" },
        { "source": "起名叫", "target": "进行名字设定为" },
        { "source": "名叫", "target": "被称作这个名字为" },
        { "source": "不能说话", "target": "处于不能进行说话的状态" },
        { "source": "无法言语", "target": "处于无法进行言语表达的状态" },
        { "source": "害怕", "target": "进入害怕的状态" },
        { "source": "惊慌", "target": "处在惊慌的状态" },
        { "source": "欢喜", "target": "产生欢喜的感觉" },
        { "source": "喜乐", "target": "产生喜乐的状态" },
        { "source": "回家", "target": "返回到自己的家中" },
        { "source": "跟随", "target": "进行跟随的行动" },
        { "source": "医治", "target": "进行医治的动作" },
        { "source": "痊愈", "target": "进入痊愈的状态" }
      ]
    },
    "source_like_possessive": {
      "description": "Overuse possessive or belonging structures similar to source-language interference.",
      "replacements": [
        { "source": "主的手", "target": "属于主的手" },
        { "source": "神的儿子", "target": "属于神的儿子" },
        { "source": "至高者的子", "target": "属于至高者的子" },
        { "source": "父亲的心", "target": "属于父亲的心" },
        { "source": "他的名", "target": "属于他的名" },
        { "source": "他的名字", "target": "属于他的名字" },
        { "source": "他的百姓", "target": "属于他的百姓" },
        { "source": "他的仆人", "target": "属于他的仆人" },
        { "source": "我的灵", "target": "属于我的灵" },
        { "source": "我的心", "target": "属于我的心" },
        { "source": "她的脚", "target": "属于她的脚" },
        { "source": "他的脚", "target": "属于他的脚" }
      ]
    },
    "redundant_explicitness": {
      "description": "Add redundant wording that sounds clunky but keeps the same event.",
      "replacements": [
        { "source": "这事", "target": "这件事情本身" },
        { "source": "这些事", "target": "这些事情本身" },
        { "source": "那时", "target": "在那个时间点上" },
        { "source": "这时", "target": "在这个时间点上" },
        { "source": "于是", "target": "在这样的情况之下于是" },
        { "source": "后来", "target": "在之后的时间里" },
        { "source": "立刻", "target": "在很快的时间之内" },
        { "source": "马上", "target": "在很快的时间之内" },
        { "source": "许多人", "target": "数量很多的人" },
        { "source": "众人", "target": "所有在场的人们" },
        { "source": "所有人", "target": "所有的人们" },
        { "source": "孩子", "target": "这个孩子本人" },
        { "source": "儿子", "target": "这个儿子本人" }
      ]
    },
    "literal_prepositional_padding": {
      "description": "Pad location/time/prepositional expressions into unnatural literal forms.",
      "replacements": [
        { "source": "在神面前", "target": "在神的面前的位置上" },
        { "source": "在至高者面前", "target": "在至高者的面前的位置上" },
        { "source": "在主面前", "target": "在主的面前的位置上" },
        { "source": "在他面前", "target": "在他的面前的位置上" },
        { "source": "在殿里", "target": "在殿的里面的位置上" },
        { "source": "在家里", "target": "在家的里面的位置上" },
        { "source": "在城里", "target": "在城的里面的位置上" },
        { "source": "在旷野", "target": "在旷野的位置上" },
        { "source": "从起初", "target": "从开始的时间点起" },
        { "source": "从今以后", "target": "从现在这个时间以后" },
        { "source": "直到永远", "target": "直到永远的时间范围" }
      ]
    },
    "awkward_passive_or_naming": {
      "description": "Use passive/naming structures that are literal and unnatural.",
      "replacements": [
        { "source": "他名叫", "target": "他被称作这个名字为" },
        { "source": "她名叫", "target": "她被称作这个名字为" },
        { "source": "名叫 人物甲", "target": "被称作人物甲这个名字" },
        { "source": "名叫 人物乙", "target": "被称作人物乙这个名字" },
        { "source": "名叫 人物丙", "target": "被称作人物丙这个名字" },
        { "source": "名叫 人物丁", "target": "被称作人物丁这个名字" },
        { "source": "起名叫 人物丙", "target": "进行名字设定为人物丙" },
        { "source": "起名叫 人物己", "target": "进行名字设定为人物己" },
        { "source": "他的名字是 人物丙", "target": "他的名字被作为人物丙这个名字" },
        { "source": "姓名要叫 人物丙", "target": "姓名需要被叫作人物丙这个名字" }
      ]
    },
    "bible_domain_awkward": {
      "description": "Bible-domain phrases rewritten into literal but meaning-preserving awkward Chinese.",
      "replacements": [
        { "source": "蒙恩", "target": "处在接受恩惠的状态" },
        { "source": "有福", "target": "处在有福气的状态" },
        { "source": "圣灵充满", "target": "被圣灵装满" },
        { "source": "充满了圣灵", "target": "被圣灵装满了" },
        { "source": "罪赦免了", "target": "罪被进行了赦免" },
        { "source": "得拯救", "target": "获得拯救这件事" },
        { "source": "救恩", "target": "拯救这件恩典" },
        { "source": "称为至高者的子", "target": "被叫作属于至高者的子" },
        { "source": "主与你同在", "target": "主在与你同在的状态中" },
        { "source": "主的手与他同在", "target": "属于主的手与他在同在状态中" },
        { "source": "信救了你", "target": "信心对你产生了拯救效果" }
      ]
    }
  }
}
