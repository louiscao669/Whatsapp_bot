        {
          "unit_index": 207,
          "verse": 49,
          "content_chars": 17,
          "text": "49 当 __PERSON_F__ 还说话时，"
        },
        {
          "unit_index": 208,
          "verse": 49,
          "content_chars": 8,
          "text": "有人从亚伊鲁家来，"
        },
        {
          "unit_index": 211,
          "verse": 49,
