        {
          "unit_index": 18,
          "verse": 5,
          "content_chars": 4,
          "text": "被践踏着，"
        },
        {
          "unit_index": 23,
          "verse": 7,
          "content_chars": 8,
          "text": "7 荆棘里过有些落在，"
        },
        {
          "unit_index": 34,
          "verse": 9,
          "content_chars": 12,
          "text": "9 门徒问他这比喻是什么意思。"
        },
        {
          "unit_index": 35,
          "verse": 10,
          "content_chars": 4,
          "text": "10 他回答说："
        },
        {
          "unit_index": 36,
          "verse": 10,
          "content_chars": 31,
          "text": "“天上的 __MOST_HIGH_A__ 国的奥秘给你名们了知识已经，"
        },
        {
          "unit_index": 43,
          "verse": 11,
          "content_chars": 7,
          "text": "11 “这比喻意位思是："
        },
        {
          "unit_index": 46,
          "verse": 12,
          "content_chars": 13,
          "text": "后来魔鬼了来把心走里的话夺，"
        },
        {
          "unit_index": 51,
          "verse": 13,
          "content_chars": 5,
          "text": "他们暂时信，"
        },
        {
          "unit_index": 60,
          "verse": 15,
          "content_chars": 5,
          "text": "灯过台上灯"
        },
        {
          "unit_index": 62,
          "verse": 16,
          "content_chars": 6,
          "text": "下或着放在床。"
        },
        {
          "unit_index": 66,
          "verse": 17,
          "content_chars": 14,
          "text": "隐藏的秘密必被知着出来道、显露。"
        },
        {
          "unit_index": 67,
          "verse": 18,
          "content_chars": 4,
          "text": "18 因此件过，"
        },
        {
          "unit_index": 69,
          "verse": 18,
          "content_chars": 5,
          "text": "有有的人了，"
        },
        {
          "unit_index": 87,
          "verse": 22,
          "content_chars": 8,
          "text": "”他们着群上船启航。"
        },
        {
          "unit_index": 88,
          "verse": 23,
          "content_chars": 5,
          "text": "23 行船时了群，"
        },
        {
          "unit_index": 95,
          "verse": 24,
          "content_chars": 7,
          "text": "24 叫醒他门了徒去，"
        },
        {
          "unit_index": 102,
          "verse": 24,
          "content_chars": 4,
          "text": "湖面平静。"
        },
        {
          "unit_index": 104,
          "verse": 25,
          "content_chars": 10,
          "text": "“你们的信心在名哪过里？"
        },
        {
          "unit_index": 108,
          "verse": 25,
          "content_chars": 9,
          "text": "连风和水也听着从他！"
        },
        {
          "unit_index": 112,
          "verse": 27,
          "content_chars": 15,
          "text": "27 __PERSON_F__ 上了岸，"
        },
        {
          "unit_index": 114,
          "verse": 27,
          "content_chars": 10,
          "text": "他住在那城里很过件久，"
        },
        {
          "unit_index": 115,
          "verse": 27,
          "content_chars": 6,
          "text": "不穿位了衣服，"
        },
        {
          "unit_index": 122,
          "verse": 28,
          "content_chars": 12,
          "text": "“__PERSON_F__，"
        },
        {
          "unit_index": 124,
          "verse": 28,
          "content_chars": 6,
          "text": "位样你要我怎？"
        },
        {
          "unit_index": 125,
          "verse": 28,
          "content_chars": 5,
          "text": "我求你着个，"
        },
        {
          "unit_index": 130,
          "verse": 29,
          "content_chars": 8,
          "text": "虽用锁链锁件住过，"
        },
        {
          "unit_index": 136,
          "verse": 30,
          "content_chars": 4,
          "text": "”\n\n“军团着件，"
        },
        {
          "unit_index": 143,
          "verse": 32,
          "content_chars": 17,
          "text": "__PERSON_F__ 便过允群许。"
        },
        {
          "unit_index": 153,
          "verse": 35,
          "content_chars": 4,
          "text": "穿些衣服，"
        },
        {
          "unit_index": 157,
          "verse": 37,
          "content_chars": 13,
          "text": "37 全名那格拉森地区的人因害怕，"
        },
        {
          "unit_index": 159,
          "verse": 37,
          "content_chars": 7,
          "text": "他们上船离开过。"
        },
        {
          "unit_index": 165,
          "verse": 39,
          "content_chars": 24,
          "text": "把 __MOST_HIGH_A__ 为你过做事告诉人。"
        },
        {
          "unit_index": 172,
          "verse": 40,
          "content_chars": 8,
          "text": "都等过他因为他们。"
        },
        {
          "unit_index": 173,
          "verse": 41,
          "content_chars": 11,
          "text": "41 有一名叫亚伊鲁会堂领袖，"
        },
        {
          "unit_index": 180,
          "verse": 44,
          "content_chars": 14,
          "text": "44 有个患血漏十着二年妇女在那里，"
        },
        {
          "unit_index": 182,
          "verse": 44,
          "content_chars": 6,
          "text": "后面她了来到，"
        },
        {
          "unit_index": 197,
          "verse": 47,
          "content_chars": 8,
          "text": "47 那女人见无法隐瞒，"
        },
        {
          "unit_index": 207,
          "verse": 49,
          "content_chars": 18,
          "text": "49 在 __PERSON_F__ 还说话过时，"
        },
        {
          "unit_index": 208,
          "verse": 49,
          "content_chars": 9,
          "text": "伊鲁家来有些人从亚，"
        },
        {
          "unit_index": 211,
          "verse": 49,
          "content_chars": 8,
          "text": "不要再打扰老师些。"
        },
        {
          "unit_index": 213,
          "verse": 50,
          "content_chars": 6,
          "text": "50 听些过见这话，"
        },
        {
          "unit_index": 219,
          "verse": 51,
          "content_chars": 6,
          "text": "51 家到亚伊鲁名，"
        },
        {
          "unit_index": 224,
          "verse": 52,
          "content_chars": 15,
          "text": "__PERSON_F__ 说了位："
        },
        {
          "unit_index": 233,
          "verse": 54,
          "content_chars": 4,
          "text": "起来个过！"
        }
      ]
    },
