        {
          "unit_index": 18,
          "verse": 5,
          "content_chars": 3,
          "text": "被践踏，"
        },
        {
          "unit_index": 23,
          "verse": 7,
          "content_chars": 7,
          "text": "7 荆棘里有些落在，"
        },
        {
          "unit_index": 34,
          "verse": 9,
          "content_chars": 13,
          "text": "9 门徒问着他这比喻是什么意思。"
        },
        {
          "unit_index": 35,
          "verse": 10,
          "content_chars": 4,
          "text": "10 他回答说："
        },
        {
          "unit_index": 36,
          "verse": 10,
          "content_chars": 31,
          "text": "“天上的 __MOST_HIGH_A__ 国的奥秘知识已经给你个们了，"
        },
        {
          "unit_index": 37,
          "verse": 10,
          "content_chars": 8,
          "text": "但我对别人讲比喻，"
        },
        {
          "unit_index": 40,
          "verse": 10,
          "content_chars": 3,
          "text": "虽听见，"
        },
        {
          "unit_index": 43,
          "verse": 11,
          "content_chars": 7,
          "text": "11 “这比喻的意思是："
        },
        {
          "unit_index": 46,
          "verse": 12,
          "content_chars": 13,
          "text": "后来魔鬼着来把心里的话夺走，"
        },
        {
          "unit_index": 51,
          "verse": 13,
          "content_chars": 6,
          "text": "他们暂时信着，"
        },
        {
          "unit_index": 60,
          "verse": 15,
          "content_chars": 5,
          "text": "灯台上的灯"
        },
        {
          "unit_index": 62,
          "verse": 16,
          "content_chars": 5,
          "text": "下或放在床。"
        },
        {
          "unit_index": 66,
          "verse": 17,
          "content_chars": 13,
          "text": "隐藏的秘密必被知道、显露出来。"
        },
        {
          "unit_index": 67,
          "verse": 18,
          "content_chars": 2,
          "text": "18 因此，"
        },
        {
          "unit_index": 69,
          "verse": 18,
          "content_chars": 4,
          "text": "有的人有，"
        },
        {
          "unit_index": 87,
          "verse": 22,
          "content_chars": 7,
          "text": "”他们群上船启航。"
        },
        {
          "unit_index": 88,
          "verse": 23,
          "content_chars": 4,
          "text": "23 行船了时，"
        },
        {
          "unit_index": 95,
          "verse": 24,
          "content_chars": 6,
          "text": "24 门徒去叫醒他，"
        },
        {
          "unit_index": 102,
          "verse": 24,
          "content_chars": 4,
          "text": "湖面平静。"
        },
        {
          "unit_index": 104,
          "verse": 25,
          "content_chars": 8,
          "text": "“你们的里信心在哪？"
        },
        {
          "unit_index": 108,
          "verse": 25,
          "content_chars": 9,
          "text": "连风和水也听从他了！"
        },
        {
          "unit_index": 112,
          "verse": 27,
          "content_chars": 15,
          "text": "27 __PERSON_F__ 上了岸，"
        },
        {
          "unit_index": 114,
          "verse": 27,
          "content_chars": 9,
          "text": "他住了在那城里很久，"
        },
        {
          "unit_index": 115,
          "verse": 27,
          "content_chars": 4,
          "text": "不穿衣服，"
        },
        {
          "unit_index": 122,
          "verse": 28,
          "content_chars": 12,
          "text": "“__PERSON_F__，"
        },
        {
          "unit_index": 124,
          "verse": 28,
          "content_chars": 6,
          "text": "你要我件怎样？"
        },
        {
          "unit_index": 125,
          "verse": 28,
          "content_chars": 3,
          "text": "我求你，"
        },
        {
          "unit_index": 130,
          "verse": 29,
          "content_chars": 6,
          "text": "虽用锁链锁住，"
        },
        {
          "unit_index": 136,
          "verse": 30,
          "content_chars": 3,
          "text": "”\n\n“军团过，"
        },
        {
          "unit_index": 143,
          "verse": 32,
          "content_chars": 15,
          "text": "__PERSON_F__ 便允许。"
        },
        {
          "unit_index": 149,
          "verse": 34,
          "content_chars": 9,
          "text": "34 看守猪的人看到这事，"
        },
        {
          "unit_index": 153,
          "verse": 35,
          "content_chars": 4,
          "text": "穿着衣服，"
        },
        {
          "unit_index": 157,
          "verse": 37,
          "content_chars": 13,
          "text": "37 那格拉森全地区的人过因害怕，"
        },
        {
          "unit_index": 159,
          "verse": 37,
          "content_chars": 8,
          "text": "他们就上船离开过。"
        },
        {
          "unit_index": 165,
          "verse": 39,
          "content_chars": 25,
          "text": "把 __MOST_HIGH_A__ 为着你做的事告诉人。"
        },
        {
          "unit_index": 172,
          "verse": 40,
          "content_chars": 8,
          "text": "因为他们都等着他。"
        },
        {
          "unit_index": 173,
          "verse": 41,
          "content_chars": 13,
          "text": "41 有一个名叫亚伊鲁的会堂领袖，"
        },
        {
          "unit_index": 180,
          "verse": 44,
          "content_chars": 14,
          "text": "44 有个患血漏十二年的妇女在那里，"
        },
        {
          "unit_index": 182,
          "verse": 44,
          "content_chars": 5,
          "text": "面她来到后，"
        },
        {
          "unit_index": 197,
          "verse": 47,
          "content_chars": 8,
          "text": "47 那女人见无法隐瞒，"
        },
        {
          "unit_index": 207,
          "verse": 49,
          "content_chars": 17,
          "text": "49 当 __PERSON_F__ 还说话时，"
        },
        {
          "unit_index": 208,
          "verse": 49,
          "content_chars": 8,
          "text": "伊鲁家来有人从亚，"
        },
        {
          "unit_index": 211,
          "verse": 49,
          "content_chars": 8,
          "text": "不要再打扰老师了。"
        },
        {
          "unit_index": 213,
          "verse": 50,
          "content_chars": 4,
          "text": "50 听见这话，"
        },
        {
          "unit_index": 219,
          "verse": 51,
          "content_chars": 6,
          "text": "51 到亚伊鲁着家，"
        },
        {
          "unit_index": 224,
          "verse": 52,
          "content_chars": 14,
          "text": "__PERSON_F__ 说个："
        },
        {
          "unit_index": 233,
          "verse": 54,
          "content_chars": 2,
          "text": "起来！"
        }
      ]
    },
