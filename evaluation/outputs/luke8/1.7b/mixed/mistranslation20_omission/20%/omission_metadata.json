          "unit_index": 122,
          "verse": 28,
          "content_chars": 12,
          "text": "“__PERSON_F__，"
        },
        {
          "unit_index": 124,
          "verse": 28,
          "content_chars": 5,
          "text": "你要我怎样？"
        },
        {
          "unit_index": 125,
          "verse": 28,
          "content_chars": 3,
          "text": "我求你，"
        },
        {
          "unit_index": 130,
          "verse": 29,
          "content_chars": 6,
          "text": "虽用铁链锁住，"
        },
        {
          "unit_index": 136,
          "verse": 30,
