          "unit_index": 143,
          "verse": 32,
          "content_chars": 15,
          "text": "__PERSON_F__ 便允许。"
        },
        {
          "unit_index": 146,
          "verse": 33,
          "content_chars": 9,
          "text": "那野猪一起奔下陡坡，"
        },
        {
          "unit_index": 149,
          "verse": 34,
          "content_chars": 7,
          "text": "34 牧猪者看到这事，"
        },
        {
          "unit_index": 153,
          "verse": 35,
          "content_chars": 4,
          "text": "穿着衣服，"
        },
        {
          "unit_index": 157,
          "verse": 37,
          "content_chars": 12,
          "text": "37 那格拉森全地区的人因恐惧，"
        },
        {
          "unit_index": 159,
          "verse": 37,
          "content_chars": 8,
          "text": "他们就上舟离开了。"
        },
        {
          "unit_index": 165,
          "verse": 39,
          "content_chars": 24,
          "text": "把 __MOST_HIGH_A__ 为你做的事告诉人。"
        },
        {
          "unit_index": 172,
          "verse": 40,
          "content_chars": 8,
          "text": "因为他们都等着他。"
        },
        {
          "unit_index": 173,
          "verse": 41,
          "content_chars": 13,
          "text": "41 有一个名叫亚伊鲁的会堂官员，"
        },
        {
          "unit_index": 180,
          "verse": 44,
          "content_chars": 14,
          "text": "44 有个血漏病十二年的妇女在那里，"
        },
        {
          "unit_index": 182,
          "verse": 44,
          "content_chars": 5,
          "text": "她来到后面，"
        },
        {
          "unit_index": 197,
          "verse": 47,
          "content_chars": 8,
          "text": "47 那女人见无法隐瞒，"
        },
        {
          "unit_index": 207,
          "verse": 49,
          "content_chars": 17,
          "text": "49 当 __PERSON_F__ 还说话时，"
        },
        {
          "unit_index": 208,
          "verse": 49,
          "content_chars": 8,
          "text": "有人从亚伊鲁家来，"
        },
        {
          "unit_index": 211,
          "verse": 49,
          "content_chars": 7,
          "text": "别再烦扰老师了。"
        },
        {
          "unit_index": 213,
          "verse": 50,
          "content_chars": 4,
          "text": "50 听见这话，"
