          "unit_index": 2,
          "verse": 1,
          "content_chars": 10,
          "text": "凯撒·奥古斯都颁布诏令，"
        },
        {
          "unit_index": 8,
          "verse": 4,
          "content_chars": 2,
          "text": "4 于是，"
        },
        {
          "unit_index": 11,
          "verse": 4,
          "content_chars": 21,
          "text": "因为他是__KING_A__家族和血统的人。"
        },
        {
          "unit_index": 12,
          "verse": 5,
          "content_chars": 30,
          "text": "5 他同有婚约、怀孕的未婚妻__PERSON_D__一同去那里登记。"
        },
        {
          "unit_index": 13,
          "verse": 6,
          "content_chars": 6,
          "text": "6 他们在那里时，"
        },
        {
          "unit_index": 16,
          "verse": 7,
          "content_chars": 4,
          "text": "用布包裹，"
        },
        {
          "unit_index": 21,
          "verse": 8,
          "content_chars": 16,
          "text": "在附近的田野有牧羊人夜间看守羊群。"
        },
        {
          "unit_index": 23,
          "verse": 9,
          "content_chars": 8,
          "text": "主的荣耀环绕他们，"
        },
        {
          "unit_index": 25,
          "verse": 10,
          "content_chars": 6,
          "text": "10 天使对他们说："
        },
        {
          "unit_index": 36,
          "verse": 13,
          "content_chars": 2,
          "text": "13 忽然，"
        },
        {
          "unit_index": 37,
          "verse": 13,
          "content_chars": 29,
          "text": "有一大队天兵与天使一同赞美__MOST_HIGH_A__说，"
        },
        {
          "unit_index": 40,
          "verse": 14,
          "content_chars": 13,
          "text": "在地上平安归与他所喜悦的人。"
        },
        {
          "unit_index": 47,
          "verse": 16,
          "content_chars": 6,
          "text": "16 他们急忙去了，"
        },
        {
          "unit_index": 48,
          "verse": 16,
          "content_chars": 27,
          "text": "找到__PERSON_D__和__PERSON_E__，"
        },
        {
          "unit_index": 50,
          "verse": 17,
          "content_chars": 4,
          "text": "17 见到他后，"
        },
        {
          "unit_index": 54,
          "verse": 19,
          "content_chars": 4,
          "text": "反复思量。"
        },
        {
          "unit_index": 72,
          "verse": 24,
          "content_chars": 9,
          "text": "“一对斑鸠或两只雏鸽。"
        },
        {
          "unit_index": 85,
          "verse": 27,
          "content_chars": 29,
          "text": "当父母带着小孩__PERSON_F__来行律法所需的礼节时，"
        },
        {
          "unit_index": 87,
          "verse": 28,
          "content_chars": 18,
          "text": "称颂__MOST_HIGH_A__说："
        },
        {
          "unit_index": 90,
          "verse": 29,
          "content_chars": 5,
          "text": "按照你的话，"
        },
        {
          "unit_index": 95,
          "verse": 31,
          "content_chars": 12,
          "text": "31 就是你在众民面前所预备的，"
        },
        {
          "unit_index": 98,
          "verse": 32,
          "content_chars": 9,
          "text": "是你民以色列的荣耀。"
        },
        {
          "unit_index": 115,
          "verse": 37,
          "content_chars": 5,
          "text": "昼夜事奉神，"
        },
        {
          "unit_index": 116,
          "verse": 37,
          "content_chars": 4,
          "text": "禁食祷告。"
        },
        {
          "unit_index": 117,
          "verse": 38,
          "content_chars": 8,
          "text": "38 忽然来到他们那里，"
        },
        {
          "unit_index": 118,
          "verse": 38,
          "content_chars": 3,
          "text": "感谢神，"
        },
        {
          "unit_index": 119,
          "verse": 38,
          "content_chars": 19,
          "text": "并向众等候耶路撒冷得赎回的人述说这孩子。"
        },
        {
          "unit_index": 121,
          "verse": 39,
          "content_chars": 9,
          "text": "39 按律法办完一切事后，"
        },
        {
          "unit_index": 122,
          "verse": 39,
          "content_chars": 59,
          "text": "__PERSON_E__和__PERSON_D__带孩子回__REGION_A__自己的城__VILLAGE_A__去。"
        },
        {
          "unit_index": 124,
          "verse": 40,
          "content_chars": 4,
          "text": "充满智慧，"
        },
        {
          "unit_index": 128,
          "verse": 41,
          "content_chars": 33,
          "text": "__PERSON_F__的父母按惯例往__CITY_A__守逾越节。"
        },
        {
          "unit_index": 129,
          "verse": 42,
          "content_chars": 6,
          "text": "42 当他十二岁时，"
        },
        {
          "unit_index": 132,
          "verse": 43,
          "content_chars": 19,
          "text": "少年__PERSON_F__仍留在殿中，"
        },
        {
          "unit_index": 134,
          "verse": 44,
          "content_chars": 5,
          "text": "44 以为他同行，"
        },
        {
          "unit_index": 136,
          "verse": 44,
          "content_chars": 8,
          "text": "便寻找亲戚和熟人。"
        },
        {
          "unit_index": 141,
          "verse": 46,
          "content_chars": 6,
          "text": "坐在教师中间，"
        },
        {
          "unit_index": 144,
          "verse": 47,
          "content_chars": 5,
          "text": "47 凡听见他的，"
        },
        {
          "unit_index": 147,
          "verse": 48,
          "content_chars": 6,
          "text": "他母亲对他说："
        },
        {
          "unit_index": 159,
          "verse": 51,
          "content_chars": 13,
          "text": "他母亲却把这一切事存在心里。"
        },
        {
          "unit_index": 162,
          "verse": 52,
          "content_chars": 5,
          "text": "都渐渐长大。"
        }
      ]
