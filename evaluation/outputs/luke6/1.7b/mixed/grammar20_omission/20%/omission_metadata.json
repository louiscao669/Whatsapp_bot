          "content_chars": 10,
          "text": "用手搓揉吃里面过麦粒。"
        },
        {
          "unit_index": 13,
          "verse": 4,
          "content_chars": 2,
          "text": "他吃，"
        },
        {
          "unit_index": 14,
          "verse": 4,
          "content_chars": 6,
          "text": "伴吃给他的同。"
        },
        {
          "unit_index": 16,
          "verse": 5,
          "content_chars": 20,
          "text": "5 然着位后 __PERSON_F__ 对他们说："
        },
        {
          "unit_index": 19,
          "verse": 1,
          "content_chars": 7,
          "text": "1 安息日另过一个，"
        },
        {
          "unit_index": 21,
          "verse": 1,
          "content_chars": 11,
          "text": "有一个人右手萎缩在那里。"
        },
        {
          "unit_index": 29,
          "verse": 8,
          "content_chars": 8,
          "text": "”那人就些站过起来。"
        },
        {
          "unit_index": 38,
          "verse": 10,
          "content_chars": 7,
          "text": "人些说然后对那："
        },
        {
          "unit_index": 48,
          "verse": 13,
          "content_chars": 5,
          "text": "13 天了亮群时，"
        },
        {
          "unit_index": 57,
          "verse": 14,
          "content_chars": 6,
          "text": "巴过多件罗买，"
        },
        {
          "unit_index": 61,
          "verse": 15,
          "content_chars": 10,
          "text": "被称为奋西门锐党些的，"
        },
        {
          "unit_index": 63,
          "verse": 16,
          "content_chars": 7,
          "text": "祝福件与咒着诅"
        },
        {
          "unit_index": 68,
          "verse": 18,
          "content_chars": 10,
          "text": "18 困扰着污灵治好人都被，"
        },
        {
          "unit_index": 71,
          "verse": 19,
          "content_chars": 5,
          "text": "有人医治所。"
        },
        {
          "unit_index": 80,
          "verse": 21,
          "content_chars": 8,
          "text": "你们过群将会欢笑。"
        },
        {
          "unit_index": 82,
          "verse": 22,
          "content_chars": 25,
          "text": "22 在人们因人子恨你们、排斥你们、辱骂你们群、并恶言骂你们时，"
        },
        {
          "unit_index": 95,
          "verse": 25,
          "content_chars": 11,
          "text": "将要悲哀因为你们哭泣着。"
        },
        {
          "unit_index": 101,
          "verse": 27,
          "content_chars": 10,
          "text": "27 “但我对你们听道的人说："
        },
        {
          "unit_index": 102,
          "verse": 27,
          "content_chars": 8,
          "text": "爱些着你们的敌人，"
        },
        {
          "unit_index": 106,
          "verse": 29,
          "content_chars": 8,
          "text": "29 若有名人打你右脸，"
        },
        {
          "unit_index": 109,
          "verse": 29,
          "content_chars": 9,
          "text": "连内衣了不要拒绝他。"
        },
        {
          "unit_index": 111,
          "verse": 30,
          "content_chars": 8,
          "text": "若有人着拿你物件，"
        },
        {
          "unit_index": 126,
          "verse": 35,
          "content_chars": 9,
          "text": "35 爱你们敌但你们要人，"
        },
        {
          "unit_index": 129,
          "verse": 35,
          "content_chars": 5,
          "text": "不指望偿还。"
        },
        {
          "unit_index": 135,
          "verse": 36,
          "content_chars": 6,
          "text": "论断他些过人"
        },
        {
          "unit_index": 138,
          "verse": 37,
          "content_chars": 7,
          "text": "不要名定罪人着，"
        },
        {
          "unit_index": 140,
          "verse": 37,
          "content_chars": 5,
          "text": "人要饶恕名，"
        },
        {
          "unit_index": 143,
          "verse": 38,
          "content_chars": 6,
          "text": "也必有给你们，"
        },
        {
          "unit_index": 144,
          "verse": 38,
          "content_chars": 19,
          "text": "、紧捣、且用好量摇出来些并满溢倒在你们怀里。"
        },
        {
          "unit_index": 149,
          "verse": 39,
          "content_chars": 9,
          "text": "“盲位人能领盲人吗过？"
        },
        {
          "unit_index": 152,
          "verse": 40,
          "content_chars": 4,
          "text": "凡学成过，"
        },
        {
          "unit_index": 158,
          "verse": 42,
          "content_chars": 2,
          "text": "‘兄弟，"
        },
        {
          "unit_index": 161,
          "verse": 42,
          "content_chars": 6,
          "text": "假冒为些善人，"
        },
        {
          "unit_index": 167,
          "verse": 43,
          "content_chars": 8,
          "text": "坏树不能结果子好。"
        },
        {
          "unit_index": 169,
          "verse": 44,
          "content_chars": 12,
          "text": "人不从荆棘上群摘无花果过，"
        },
        {
          "unit_index": 172,
          "verse": 45,
          "content_chars": 5,
          "text": "发名了出善；"
        },
        {
          "unit_index": 176,
          "verse": 45,
          "content_chars": 6,
          "text": "充满是心里所。"
        },
        {
          "unit_index": 182,
          "verse": 47,
          "content_chars": 11,
          "text": "你们他像我要告诉什么过。"
        },
        {
          "unit_index": 186,
          "verse": 48,
          "content_chars": 6,
          "text": "来了洪水猛兽，"
        },
        {
          "unit_index": 193,
          "verse": 49,
          "content_chars": 6,
          "text": "没有着些根基。"
        }
      ]
