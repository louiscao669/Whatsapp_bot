        {
          "unit_index": 4,
          "verse": 1,
          "content_chars": 10,
          "text": "用手搓揉吃里面的麦粒。"
        },
        {
          "unit_index": 9,
          "verse": 3,
          "content_chars": 29,
          "text": "“你们从未读过 __KING_A__ 和他的同伴饥饿时所做的事吗？"
        },
        {
          "unit_index": 11,
          "verse": 4,
          "content_chars": 6,
          "text": "拿起奉献的饼，"
        },
        {
          "unit_index": 13,
          "verse": 4,
          "content_chars": 3,
          "text": "他吃了，"
        },
        {
          "unit_index": 14,
          "verse": 4,
          "content_chars": 7,
          "text": "也给他的同伴吃。"
        },
        {
          "unit_index": 16,
          "verse": 5,
          "content_chars": 18,
          "text": "5 然后 __PERSON_F__ 对他们说："
        },
        {
          "unit_index": 19,
          "verse": 1,
          "content_chars": 6,
          "text": "1 另一个安息日，"
        },
        {
          "unit_index": 21,
          "verse": 1,
          "content_chars": 11,
          "text": "有一个人右手萎缩在那里。"
        },
        {
          "unit_index": 26,
          "verse": 8,
          "content_chars": 8,
          "text": "对那萎缩手的人说："
        },
        {
          "unit_index": 28,
          "verse": 8,
          "content_chars": 6,
          "text": "站在众人面前。"
        },
        {
          "unit_index": 29,
          "verse": 8,
          "content_chars": 7,
          "text": "”那人就站了起来。"
        },
        {
          "unit_index": 34,
          "verse": 9,
          "content_chars": 6,
          "text": "救命还是害命，"
        },
        {
          "unit_index": 38,
          "verse": 10,
          "content_chars": 6,
          "text": "然后对那人说："
        },
        {
          "unit_index": 42,
          "verse": 11,
          "content_chars": 13,
          "text": "11 法利赛人和律法教师非常恼怒，"
        },
        {
          "unit_index": 47,
          "verse": 12,
          "content_chars": 31,
          "text": "整夜 __REQUEST_A__ 给 __MOST_HIGH_A__。"
        },
        {
          "unit_index": 48,
          "verse": 13,
          "content_chars": 3,
          "text": "13 天亮时，"
        },
        {
          "unit_index": 55,
          "verse": 14,
          "content_chars": 12,
          "text": "__PERSON_C__，"
        },
        {
          "unit_index": 57,
          "verse": 14,
          "content_chars": 4,
          "text": "巴多罗买，"
        },
        {
          "unit_index": 61,
          "verse": 15,
          "content_chars": 9,
          "text": "被称为奋锐党的西门，"
        },
        {
          "unit_index": 63,
          "verse": 16,
          "content_chars": 5,
          "text": "祝福与咒诅"
        },
        {
          "unit_index": 66,
          "verse": 17,
          "content_chars": 42,
          "text": "许多门徒和来自犹地亚各地、__CITY_A__ 及推罗和西顿沿海地区的人们聚集来听他教导，"
        },
        {
          "unit_index": 68,
          "verse": 18,
          "content_chars": 11,
          "text": "18 困扰着污灵的人都被治好，"
        },
        {
          "unit_index": 71,
          "verse": 19,
          "content_chars": 6,
          "text": "医治了所有人。"
        },
        {
          "unit_index": 80,
          "verse": 21,
          "content_chars": 6,
          "text": "你们将会欢笑。"
        },
        {
          "unit_index": 82,
          "verse": 22,
          "content_chars": 24,
          "text": "22 当人们因人子恨你们、排斥你们、辱骂你们、并恶言骂你们时，"
        },
        {
          "unit_index": 85,
          "verse": 23,
          "content_chars": 9,
          "text": "23 “那日你们要欢喜跳跃，"
        },
        {
          "unit_index": 95,
          "verse": 25,
          "content_chars": 10,
          "text": "因为你们将要悲哀哭泣。"
        },
        {
          "unit_index": 101,
          "verse": 27,
          "content_chars": 10,
          "text": "27 “但我对你们听道的人说："
        },
        {
          "unit_index": 102,
          "verse": 27,
          "content_chars": 6,
          "text": "爱你们的敌人，"
        },
        {
          "unit_index": 105,
          "verse": 28,
          "content_chars": 9,
          "text": "为虐待你们的人祷告。"
        },
        {
          "unit_index": 106,
          "verse": 29,
          "content_chars": 8,
          "text": "29 若有人打你的右脸，"
        },
        {
          "unit_index": 109,
          "verse": 29,
          "content_chars": 9,
          "text": "连内衣也不要拒绝他。"
        },
        {
          "unit_index": 110,
          "verse": 30,
          "content_chars": 8,
          "text": "30 凡向你要的就给他，"
        },
        {
          "unit_index": 111,
          "verse": 30,
          "content_chars": 8,
          "text": "若有人拿你的物件，"
        },
        {
          "unit_index": 120,
          "verse": 33,
          "content_chars": 6,
          "text": "有什么赏赐呢？"
        },
        {
          "unit_index": 126,
          "verse": 35,
          "content_chars": 10,
          "text": "35 但你们要爱你们的敌人，"
        },
        {
          "unit_index": 129,
          "verse": 35,
          "content_chars": 5,
          "text": "不指望偿还。"
        },
        {
          "unit_index": 135,
          "verse": 36,
          "content_chars": 4,
          "text": "论断他人"
        },
        {
          "unit_index": 138,
          "verse": 37,
          "content_chars": 5,
          "text": "不要定罪人，"
        },
        {
          "unit_index": 140,
          "verse": 37,
          "content_chars": 4,
          "text": "要饶恕人，"
        },
        {
          "unit_index": 143,
          "verse": 38,
          "content_chars": 7,
          "text": "就必有给你们的，"
        },
        {
          "unit_index": 144,
          "verse": 38,
          "content_chars": 18,
          "text": "且用好量、紧捣、摇出来并满溢倒在你们怀里。"
        },
        {
          "unit_index": 149,
          "verse": 39,
          "content_chars": 7,
          "text": "“盲人能领盲人吗？"
        },
        {
          "unit_index": 152,
          "verse": 40,
          "content_chars": 5,
          "text": "凡学成了的，"
        },
        {
          "unit_index": 157,
          "verse": 42,
          "content_chars": 7,
          "text": "42 你怎能对弟兄说，"
        },
        {
          "unit_index": 158,
          "verse": 42,
          "content_chars": 2,
          "text": "‘兄弟，"
        },
        {
          "unit_index": 161,
          "verse": 42,
          "content_chars": 6,
          "text": "假冒为善的人，"
        },
        {
          "unit_index": 167,
          "verse": 43,
          "content_chars": 8,
          "text": "坏树不能结果子好。"
        },
        {
          "unit_index": 169,
          "verse": 44,
          "content_chars": 10,
          "text": "人不从荆棘上摘无花果，"
        },
        {
          "unit_index": 172,
          "verse": 45,
          "content_chars": 3,
          "text": "发出善；"
        },
        {
          "unit_index": 176,
          "verse": 45,
          "content_chars": 7,
          "text": "是心里所充满的。"
        },
        {
          "unit_index": 182,
          "verse": 47,
          "content_chars": 10,
          "text": "我要告诉你们他像什么。"
        },
        {
          "unit_index": 186,
          "verse": 48,
          "content_chars": 5,
          "text": "洪水猛兽来，"
        },
        {
          "unit_index": 193,
          "verse": 49,
          "content_chars": 4,
          "text": "没有根基。"
        },
        {
          "unit_index": 194,
          "verse": 49,
          "content_chars": 6,
          "text": "洪水猛兽一来，"
        }
      ]
    },
