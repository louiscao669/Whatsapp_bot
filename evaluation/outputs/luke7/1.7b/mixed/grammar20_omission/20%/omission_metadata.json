          "unit_index": 169,
          "verse": 40,
          "content_chars": 17,
          "text": "40 __PERSON_F__ 对他说位了："
        },
        {
          "unit_index": 170,
          "verse": 40,
          "content_chars": 4,
          "text": "“西着名门，"
        },
        {
          "unit_index": 172,
          "verse": 40,
          "content_chars": 4,
          "text": "”  \n\n“请过群说，"
        },
        {
          "unit_index": 173,
          "verse": 40,
          "content_chars": 4,
          "text": "老名师着，"
        },
        {
          "unit_index": 180,
          "verse": 42,
          "content_chars": 10,
          "text": "债主就免债了他们件的。"
        },
        {
          "unit_index": 184,
          "verse": 43,
          "content_chars": 6,
          "text": "43 答说西了门回："
        },
        {
          "unit_index": 195,
          "verse": 44,
          "content_chars": 8,
          "text": "又用头位着发擦干。"
        },
        {
          "unit_index": 196,
          "verse": 45,
          "content_chars": 9,
          "text": "45 你没有给我着件亲嘴，"
        },
        {
          "unit_index": 201,
          "verse": 47,
          "content_chars": 8,
          "text": "罪赦免了她许多的，"
        },
        {
          "unit_index": 202,
          "verse": 47,
          "content_chars": 8,
          "text": "因为她爱得名多着；"
        },
        {
          "unit_index": 204,
          "verse": 47,
          "content_chars": 3,
          "text": "爱件少。"
        }
