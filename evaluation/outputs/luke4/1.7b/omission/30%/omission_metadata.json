      "omitted_units": [
        {
          "unit_index": 6,
          "verse": 2,
          "content_chars": 4,
          "text": "到了最后，"
        },
        {
          "unit_index": 11,
          "verse": 3,
          "content_chars": 11,
          "text": "就叫这块石头变成食物吧。"
        },
        {
          "unit_index": 13,
          "verse": 4,
          "content_chars": 15,
          "text": "4 __PERSON_F__ 回答说："
        },
        {
          "unit_index": 14,
          "verse": 4,
          "content_chars": 5,
          "text": "“经上记着说："
        },
        {
          "unit_index": 15,
          "verse": 4,
          "content_chars": 3,
          "text": "‘人活着，"
        },
        {
          "unit_index": 20,
          "verse": 6,
          "content_chars": 1,
          "text": "6 说："
        },
        {
          "unit_index": 22,
          "verse": 6,
          "content_chars": 10,
          "text": "因为这一切都赐给了我，"
        },
        {
          "unit_index": 23,
          "verse": 6,
          "content_chars": 9,
          "text": "我想赐给谁就赐给谁。"
        },
        {
          "unit_index": 36,
          "verse": 9,
          "content_chars": 8,
          "text": "就从这里跳下去吧。"
        },
        {
          "unit_index": 37,
          "verse": 10,
          "content_chars": 7,
          "text": "10 因为经上记着说："
        },
        {
          "unit_index": 38,
          "verse": 10,
          "content_chars": 10,
          "text": "‘他要为你吩咐他的使者，"
        },
        {
          "unit_index": 44,
          "verse": 12,
          "content_chars": 13,
          "text": "12 __PERSON_F__ 说："
        },
        {
          "unit_index": 45,
          "verse": 12,
          "content_chars": 6,
          "text": "“经上又记着说："
        },
        {
          "unit_index": 51,
          "verse": 13,
          "content_chars": 29,
          "text": "__PERSON_F__ 在 __VILLAGE_A__ 被拒绝"
        },
        {
          "unit_index": 53,
          "verse": 14,
          "content_chars": 13,
          "text": "关于他的消息传遍了整个乡村。"
        },
        {
          "unit_index": 57,
          "verse": 16,
          "content_chars": 16,
          "text": "16 他来到 __VILLAGE_A__ ，"
        },
        {
          "unit_index": 58,
          "verse": 16,
          "content_chars": 9,
          "text": "那里是他长大的地方。"
        },
        {
          "unit_index": 59,
          "verse": 16,
          "content_chars": 5,
          "text": "到了安息日，"
        },
        {
          "unit_index": 62,
          "verse": 17,
          "content_chars": 14,
          "text": "17 有人把先知以赛亚的书卷交给他。"
        },
        {
          "unit_index": 63,
          "verse": 17,
          "content_chars": 3,
          "text": "他展开，"
        },
        {
          "unit_index": 67,
          "verse": 18,
          "content_chars": 5,
          "text": "因为他膏我，"
        },
        {
          "unit_index": 68,
          "verse": 18,
          "content_chars": 9,
          "text": "叫我传好信息给穷人，"
        },
        {
          "unit_index": 77,
          "verse": 20,
          "content_chars": 15,
          "text": "会堂里的众人都目不转睛地看着他。"
        },
        {
          "unit_index": 79,
          "verse": 21,
          "content_chars": 12,
          "text": "“今天这经应验在你们耳中了。"
        },
        {
          "unit_index": 81,
          "verse": 22,
          "content_chars": 6,
          "text": "22 众人都称赞他，"
        },
        {
          "unit_index": 86,
          "verse": 23,
          "content_chars": 16,
          "text": "23 __PERSON_F__ 对他们说："
        },
        {
          "unit_index": 94,
          "verse": 24,
          "content_chars": 7,
          "text": "24 “我实在告诉你们，"
        },
        {
          "unit_index": 95,
          "verse": 24,
          "content_chars": 7,
          "text": "先知在自己家乡，"
        },
        {
          "unit_index": 96,
          "verse": 24,
          "content_chars": 6,
          "text": "往往不得尊敬。"
        },
        {
          "unit_index": 97,
          "verse": 25,
          "content_chars": 3,
          "text": "25 我保证，"
        },
        {
          "unit_index": 98,
          "verse": 25,
          "content_chars": 17,
          "text": "在 __PROPHET_A__ 的时候，"
        },
        {
          "unit_index": 100,
          "verse": 25,
          "content_chars": 5,
          "text": "遍地大饥荒，"
        },
        {
          "unit_index": 102,
          "verse": 26,
          "content_chars": 25,
          "text": "26 但 __PROPHET_A__ 并没有被差到他们那里去，"
        },
        {
          "unit_index": 104,
          "verse": 27,
          "content_chars": 9,
          "text": "27 当以利沙先知的时候，"
        },
        {
          "unit_index": 109,
          "verse": 28,
          "content_chars": 5,
          "text": "28 听见这些话，"
        },
        {
          "unit_index": 116,
          "verse": 30,
          "content_chars": 4,
          "text": "继续前行。"
        },
        {
          "unit_index": 122,
          "verse": 32,
          "content_chars": 4,
          "text": "感到惊讶。"
        },
        {
          "unit_index": 124,
          "verse": 33,
          "content_chars": 4,
          "text": "33 在会堂里，"
        },
        {
          "unit_index": 131,
          "verse": 34,
          "content_chars": 20,
          "text": "你是 __MOST_HIGH_A__ 的圣者！"
        },
        {
          "unit_index": 134,
          "verse": 35,
          "content_chars": 2,
          "text": "“住口！"
        },
        {
          "unit_index": 135,
          "verse": 35,
          "content_chars": 6,
          "text": "从他身上出来！"
        },
        {
          "unit_index": 150,
          "verse": 38,
          "content_chars": 18,
          "text": "他们请 __PERSON_F__ 帮助她。"
        },
        {
          "unit_index": 158,
          "verse": 41,
          "content_chars": 7,
          "text": "41 许多人被鬼附着，"
        },
        {
          "unit_index": 162,
          "verse": 41,
          "content_chars": 6,
          "text": "不允许鬼说话，"
        },
        {
          "unit_index": 163,
          "verse": 41,
          "content_chars": 11,
          "text": "因为他们知道他是弥赛亚。"
        },
        {
          "unit_index": 165,
          "verse": 42,
          "content_chars": 3,
          "text": "42 天亮时，"
        },
        {
          "unit_index": 167,
          "verse": 42,
          "content_chars": 5,
          "text": "人们寻找他，"
        },
        {
          "unit_index": 170,
          "verse": 43,
          "content_chars": 5,
          "text": "43 他对他们说："
        },
        {
          "unit_index": 173,
          "verse": 43,
          "content_chars": 11,
          "text": "因为我就是为此被差来的。"
        },
        {
          "unit_index": 175,
          "verse": 44,
          "content_chars": 13,
          "text": "44 他就在犹太的会堂里不断传道。"
        }
      ]
    },
