          "unit_index": 1,
          "verse": 1,
          "content_chars": 20,
          "text": "1 许多人已着手编写我们中间所成就事迹的记载，"
        },
        {
          "unit_index": 3,
          "verse": 3,
          "content_chars": 14,
          "text": "3 我自己既然从头仔细考察了一切，"
        },
        {
          "unit_index": 5,
          "verse": 3,
          "content_chars": 19,
          "text": "有最尊贵 __RECIPIENT_A__，"
        },
        {
          "unit_index": 6,
          "verse": 3,
          "content_chars": 9,
          "text": "写一卷有条理的记述，"
        },
        {
          "unit_index": 9,
          "verse": 5,
          "content_chars": 33,
          "text": "5 在 __LOCAL_PLACE_01__ 王 __RULER_A__ 时代，"
        },
        {
          "unit_index": 11,
          "verse": 5,
          "content_chars": 20,
          "text": "属于 __DIVISION_A__ 祭司班次；"
        },
        {
          "unit_index": 31,
          "verse": 12,
          "content_chars": 5,
          "text": "惊名慌害怕。"
        },
        {
          "unit_index": 38,
          "verse": 14,
          "content_chars": 10,
          "text": "14 他将带给欢欣你喜乐和，"
        },
        {
          "unit_index": 47,
          "verse": 17,
          "content_chars": 22,
          "text": "预备一群合适的人归顺 __MASTER_A__。"
        },
        {
          "unit_index": 56,
          "verse": 19,
          "content_chars": 22,
          "text": "常侍至高者 __MOST_HIGH_A__ 面前，"
        },
        {
          "unit_index": 58,
          "verse": 19,
          "content_chars": 8,
          "text": "并将这美事报给你。"
        },
        {
          "unit_index": 66,
          "verse": 22,
          "content_chars": 10,
          "text": "22 他出来不说话能与他们，"
        },
        {
          "unit_index": 68,
          "verse": 22,
          "content_chars": 12,
          "text": "因为他不停比手势给他们看，"
        },
        {
          "unit_index": 79,
          "verse": 25,
          "content_chars": 9,
          "text": "除去过民间我的羞辱。"
        },
        {
          "unit_index": 83,
          "verse": 27,
          "content_chars": 23,
          "text": "27 天使被差到一 __LOCAL_ROLE_03__，"
        },
        {
          "unit_index": 85,
          "verse": 27,
          "content_chars": 17,
          "text": "未婚夫名为 __PERSON_E__，"
        },
        {
          "unit_index": 99,
          "verse": 31,
          "content_chars": 6,
          "text": "31 你将怀孕生子，"
        },
        {
          "unit_index": 102,
          "verse": 32,
          "content_chars": 8,
          "text": "被称为至尊者的子。"
        },
        {
          "unit_index": 121,
          "verse": 38,
          "content_chars": 20,
          "text": "“我是主 __LOCAL_ROLE_02__，"
        },
        {
          "unit_index": 123,
          "verse": 38,
          "content_chars": 7,
          "text": "”随即天使离开她。"
        },
        {
          "unit_index": 131,
          "verse": 42,
          "content_chars": 4,
          "text": "42 她大声说："
        },
        {
          "unit_index": 133,
          "verse": 42,
          "content_chars": 11,
          "text": "你所怀的孩子也是有福的！"
        },
        {
          "unit_index": 134,
          "verse": 43,
          "content_chars": 8,
          "text": "43 为什么了我蒙此恩，"
        },
        {
          "unit_index": 137,
          "verse": 44,
          "content_chars": 7,
          "text": "腹中胎儿就欢跃。"
        },
        {
          "unit_index": 138,
          "verse": 45,
          "content_chars": 6,
          "text": "45 信主应许的过，"
        },
        {
          "unit_index": 156,
          "verse": 51,
          "content_chars": 8,
          "text": "51 施展大能他用膀臂，"
        },
        {
          "unit_index": 159,
          "verse": 52,
          "content_chars": 8,
          "text": "52 他使有权柄的离位，"
        },
        {
          "unit_index": 165,
          "verse": 54,
          "content_chars": 10,
          "text": "54 他扶助他的仆人以色列，"
        },
        {
          "unit_index": 166,
          "verse": 54,
          "content_chars": 12,
          "text": "记念施过怜悯给我们的祖先，"
        },
        {
          "unit_index": 168,
          "verse": 55,
          "content_chars": 14,
          "text": "55 也像他对他们祖宗所应许的那样，"
        },
        {
          "unit_index": 172,
          "verse": 56,
          "content_chars": 5,
          "text": "然名后回去。"
        },
        {
          "unit_index": 176,
          "verse": 58,
          "content_chars": 10,
          "text": "58 邻居亲友悯她听说主怜，"
        },
        {
          "unit_index": 183,
          "verse": 60,
          "content_chars": 2,
          "text": "“不可，"
        },
        {
          "unit_index": 184,
          "verse": 60,
          "content_chars": 15,
          "text": "姓要叫 __PERSON_C__。"
        },
        {
          "unit_index": 189,
          "verse": 62,
          "content_chars": 17,
          "text": "62 便用手势问孩子的父亲想过叫他什么名。"
        },
        {
          "unit_index": 190,
          "verse": 63,
          "content_chars": 6,
          "text": "63 他要求书写板，"
        },
        {
          "unit_index": 192,
          "verse": 63,
          "content_chars": 17,
          "text": "字是“他的名 __PERSON_C__。"
        },
        {
          "unit_index": 195,
          "verse": 64,
          "content_chars": 4,
          "text": "舌头释放，"
        },
        {
          "unit_index": 196,
          "verse": 64,
          "content_chars": 6,
          "text": "他开些始说话，"
        },
        {
          "unit_index": 198,
          "verse": 65,
          "content_chars": 7,
          "text": "65 邻居过们都惊奇，"
        },
        {
          "unit_index": 202,
          "verse": 66,
          "content_chars": 15,
          "text": "__PERSON_A__ 的颂歌"
        },
        {
          "unit_index": 214,
          "verse": 70,
          "content_chars": 16,
          "text": "在他仆人 __KING_A__ 家里，"
        },
        {
          "unit_index": 218,
          "verse": 72,
          "content_chars": 11,
          "text": "72 使我们从得拯救仇敌手中，"
        },
        {
          "unit_index": 232,
          "verse": 76,
          "content_chars": 9,
          "text": "前预备道要在主面路，"
        },
        {
          "unit_index": 237,
          "verse": 78,
          "content_chars": 8,
          "text": "78 因我们至高者慈悲，"
        }
      ]
    },
