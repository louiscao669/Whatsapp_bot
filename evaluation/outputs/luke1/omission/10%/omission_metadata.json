          "content_chars": 20,
          "text": "有最尊贵的 __RECIPIENT_A__，"
        },
        {
          "unit_index": 11,
          "verse": 5,
          "content_chars": 21,
          "text": "属于 __DIVISION_A__ 的祭司班次；"
        },
        {
          "unit_index": 31,
          "verse": 12,
          "content_chars": 4,
          "text": "惊慌害怕。"
        },
        {
          "unit_index": 38,
          "verse": 14,
          "content_chars": 10,
          "text": "14 他将带给你喜乐和欢欣，"
        },
        {
          "unit_index": 66,
          "verse": 22,
          "content_chars": 10,
          "text": "22 他出来不能与他们说话，"
        },
        {
          "unit_index": 79,
          "verse": 25,
          "content_chars": 9,
          "text": "除去了民间我的羞辱。"
        },
        {
          "unit_index": 83,
          "verse": 27,
          "content_chars": 24,
          "text": "27 天使被差到一位 __LOCAL_ROLE_03__，"
        },
        {
          "unit_index": 121,
          "verse": 38,
          "content_chars": 21,
          "text": "“我是主的 __LOCAL_ROLE_02__，"
        },
        {
          "unit_index": 134,
          "verse": 43,
          "content_chars": 7,
          "text": "43 为什么我蒙此恩，"
        },
        {
          "unit_index": 138,
          "verse": 45,
          "content_chars": 5,
          "text": "45 信主应许的，"
        },
        {
          "unit_index": 156,
          "verse": 51,
          "content_chars": 8,
          "text": "51 他用膀臂施展大能，"
        },
        {
          "unit_index": 166,
          "verse": 54,
          "content_chars": 11,
          "text": "记念施怜悯给我们的祖先，"
        },
        {
          "unit_index": 168,
          "verse": 55,
          "content_chars": 14,
          "text": "55 就像他对他们祖宗所应许的那样，"
        },
        {
          "unit_index": 172,
          "verse": 56,
          "content_chars": 4,
          "text": "然后回去。"
        },
        {
          "unit_index": 176,
          "verse": 58,
          "content_chars": 10,
          "text": "58 邻居亲友听说主怜悯她，"
        },
        {
          "unit_index": 184,
          "verse": 60,
          "content_chars": 16,
          "text": "姓名要叫 __PERSON_C__。"
        },
        {
          "unit_index": 189,
          "verse": 62,
          "content_chars": 16,
          "text": "62 便用手势问孩子的父亲想叫他什么名。"
        },
        {
          "unit_index": 192,
          "verse": 63,
          "content_chars": 17,
          "text": "“他的名字是 __PERSON_C__。"
        },
        {
          "unit_index": 196,
          "verse": 64,
          "content_chars": 5,
          "text": "他开始说话，"
        },
        {
          "unit_index": 198,
          "verse": 65,
          "content_chars": 6,
          "text": "65 邻居们都惊奇，"
        },
        {
          "unit_index": 218,
          "verse": 72,
          "content_chars": 11,
          "text": "72 使我们从仇敌手中得拯救，"
        },
        {
          "unit_index": 232,
          "verse": 76,
          "content_chars": 9,
          "text": "要在主面前预备道路，"
        },
        {
          "unit_index": 237,
          "verse": 78,
          "content_chars": 9,
          "text": "78 因我们至高者的慈悲，"
        }
      ]
    },
