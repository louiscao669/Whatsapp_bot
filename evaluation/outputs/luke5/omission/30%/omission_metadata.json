        {
          "unit_index": 4,
          "verse": 2,
          "content_chars": 8,
          "text": "2 他见水边有两只船，"
        },
        {
          "unit_index": 5,
          "verse": 2,
          "content_chars": 6,
          "text": "是渔夫留下的，"
        },
        {
          "unit_index": 9,
          "verse": 3,
          "content_chars": 11,
          "text": "然后坐下在船上教导众人。"
        },
        {
          "unit_index": 19,
          "verse": 5,
          "content_chars": 4,
          "text": "一无所获；"
        },
        {
          "unit_index": 21,
          "verse": 5,
          "content_chars": 4,
          "text": "我就下网。"
        },
        {
          "unit_index": 23,
          "verse": 6,
          "content_chars": 5,
          "text": "6 他们下网后，"
        },
        {
          "unit_index": 24,
          "verse": 6,
          "content_chars": 8,
          "text": "网里竟捉到许多鱼，"
        },
        {
          "unit_index": 43,
          "verse": 11,
          "content_chars": 3,
          "text": "“不要怕，"
        },
        {
          "unit_index": 47,
          "verse": 11,
          "content_chars": 4,
          "text": "跟随了他。"
        },
        {
          "unit_index": 51,
          "verse": 12,
          "content_chars": 14,
          "text": "见到 __PERSON_F__，"
        },
        {
          "unit_index": 59,
          "verse": 13,
          "content_chars": 1,
          "text": "说："
        },
        {
          "unit_index": 60,
          "verse": 13,
          "content_chars": 2,
          "text": "“我肯，"
        },
        {
          "unit_index": 66,
          "verse": 14,
          "content_chars": 18,
          "text": "去向 __WORKER_A__ 展示自己，"
        },
        {
          "unit_index": 67,
          "verse": 14,
          "content_chars": 14,
          "text": "并献上摩西所吩咐为洁净的供物，"
        },
        {
          "unit_index": 68,
          "verse": 14,
          "content_chars": 6,
          "text": "为他们作见证。"
        },
        {
          "unit_index": 72,
          "verse": 15,
          "content_chars": 4,
          "text": "接受医治。"
        },
        {
          "unit_index": 73,
          "verse": 16,
          "content_chars": 26,
          "text": "16 但 __PERSON_F__ 常常退到旷野的隐秘地方祷告。"
        },
        {
          "unit_index": 77,
          "verse": 17,
          "content_chars": 33,
          "text": "他们从 __REGION_A__ 各村、犹太和 __CITY_A__ 都来了。"
        },
        {
          "unit_index": 78,
          "verse": 17,
          "content_chars": 30,
          "text": "__MASTER_A__ 的能力与 __PERSON_F__ 同在，"
        },
        {
          "unit_index": 89,
          "verse": 20,
          "content_chars": 1,
          "text": "说："
        },
        {
          "unit_index": 90,
          "verse": 20,
          "content_chars": 2,
          "text": "“朋友，"
        },
        {
          "unit_index": 91,
          "verse": 20,
          "content_chars": 5,
          "text": "你的罪赦了。"
        },
        {
          "unit_index": 93,
          "verse": 21,
          "content_chars": 14,
          "text": "21 法利赛人和律法教师心里议论说："
        },
        {
          "unit_index": 94,
          "verse": 21,
          "content_chars": 7,
          "text": "“这人说僭妄话了，"
        },
        {
          "unit_index": 95,
          "verse": 21,
          "content_chars": 4,
          "text": "谁能赦罪，"
        },
        {
          "unit_index": 98,
          "verse": 22,
          "content_chars": 20,
          "text": "22 __PERSON_F__ 既知道他们的心思，"
        },
        {
          "unit_index": 99,
          "verse": 22,
          "content_chars": 2,
          "text": "就问："
        },
        {
          "unit_index": 102,
          "verse": 23,
          "content_chars": 10,
          "text": "还是说‘起来行走’容易呢？"
        },
        {
          "unit_index": 108,
          "verse": 24,
          "content_chars": 9,
          "text": "拿你的褥子回家去吧！"
        },
        {
          "unit_index": 111,
          "verse": 25,
          "content_chars": 4,
          "text": "拿起褥子，"
        },
        {
          "unit_index": 121,
          "verse": 27,
          "content_chars": 14,
          "text": "__PERSON_F__ 出去，"
        },
        {
          "unit_index": 124,
          "verse": 27,
          "content_chars": 5,
          "text": "坐在税关上。"
        },
        {
          "unit_index": 131,
          "verse": 29,
          "content_chars": 24,
          "text": "29 利未在家为 __PERSON_F__ 举办丰盛的筵席，"
        },
        {
          "unit_index": 138,
          "verse": 31,
          "content_chars": 8,
          "text": "有病的人才用得着。"
        },
        {
          "unit_index": 145,
          "verse": 33,
          "content_chars": 8,
          "text": "唯有你的门徒吃喝。"
        },
        {
          "unit_index": 147,
          "verse": 34,
          "content_chars": 15,
          "text": "34 __PERSON_F__ 回答说："
        },
        {
          "unit_index": 148,
          "verse": 34,
          "content_chars": 10,
          "text": "“新郎与朋友同在的时候，"
        },
        {
          "unit_index": 152,
          "verse": 35,
          "content_chars": 7,
          "text": "新郎要离开他们，"
        },
        {
          "unit_index": 155,
          "verse": 36,
          "content_chars": 10,
          "text": "36 他对他们讲了一个比喻："
        },
        {
          "unit_index": 156,
          "verse": 36,
          "content_chars": 9,
          "text": "“没人用新布补旧衣服，"
        },
        {
          "unit_index": 157,
          "verse": 36,
          "content_chars": 8,
          "text": "免得把新衣服撕坏，"
        },
        {
          "unit_index": 158,
          "verse": 36,
          "content_chars": 10,
          "text": "补布与旧衣服却不相称。"
        },
        {
          "unit_index": 164,
          "verse": 39,
          "content_chars": 13,
          "text": "39 饮过陈酒的人也不愿意喝新酒，"
        },
        {
          "unit_index": 165,
          "verse": 39,
          "content_chars": 7,
          "text": "因为他说‘陈酒好’。"
        }
      ]
    },
