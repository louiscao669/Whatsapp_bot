.env
# Every .env variant, not just the bare name. A `.env.backup-*` written during
# maintenance carries the same 16 secrets and was caught only by GitHub's push
# protection, one commit short of publishing a live OpenAI and Supabase key.
.env.*
!.env.example
node_modules/
platform/frontend/dist/
__pycache__/
*.py[cod]
.DS_Store

# Generated research artifacts (keep scripts, configs, datasets, and inputs tracked).
evaluation/outputs
QA_algorithm/outputs

# Editor / tooling leftovers
*.bak
*.bak[0-9]
*.orig
*.rej
*.tmp
.pytest_cache/

# Generated translation cache. Delete this rule if you decide the wbw token
# cache should be version-controlled for reproducibility (see
# WBW_DIVERGENCE_EXPLANATION_2026-07-17.md) -- it is a generated artifact
# living in datasets/, which is otherwise inputs only.
evaluation/datasets/perturbations/.wbw_cache_*.json
