# ETEN platform: participant pilot UI (/pilot), user dashboard, admin API.
#
# Install to /etc/systemd/system/eten-platform.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now eten-platform
#
# This unit runs gunicorn directly, so the deploy/gunicorn/override.conf
# drop-in is NOT needed on a machine set up from this file -- that drop-in
# exists only to convert an older unit that still called `python platform/app.py`.

[Unit]
Description=ETEN Platform (participant dashboard + admin API)
# network-online, not just network: the app connects to Supabase during
# startup (engine warm-up + migrations) and a half-configured interface at
# boot makes that fail in a way the service does not retry.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lcao4_nd_edu
Group=lcao4_nd_edu
WorkingDirectory=/opt/eten-whatsapp-bot
EnvironmentFile=/opt/eten-whatsapp-bot/.env
ExecStart=/opt/eten-whatsapp-bot/.venv/bin/gunicorn \
    --chdir /opt/eten-whatsapp-bot/platform \
    --config /opt/eten-whatsapp-bot/deploy/gunicorn/gunicorn.conf.py \
    wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
KillSignal=SIGTERM
# Long enough for gunicorn to finish in-flight requests; a participant
# mid-submit should not lose an answer to a restart.
TimeoutStopSec=40
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
